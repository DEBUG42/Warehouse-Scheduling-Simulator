{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SDL3",
      "type": "shell",
      "command": "g++",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",

        "-static-libgcc",
        "-static-libstdc++",
        "-Wl`,-subsystem,windows"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe 生成活动文件",
      "command": "G:/mingw64/bin/g++.exe", //G盘的
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-I\"G:/SFML/SFML-2.6.2/include\"", //自己的
        "-DSFML_STATIC",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "-L\"G:/SFML/SFML-2.6.2/lib\"", //自己的
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system"
      ],
      "options": {
        "cwd": "G:/mingw64/bin/" //自己的
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "调试器生成的任务。"
    }
  ]
}
